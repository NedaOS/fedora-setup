#!/usr/bin/env bash
set -Eeuo pipefail

SOURCE_DIR="$HOME/.local/share/chezmoi"
LOG_PREFIX="[chezmoi-auto-sync]"

log() {
  printf '%s %s\n' "$LOG_PREFIX" "$*"
}

# Ensure the source directory is a Git repository.
if ! git -C "$SOURCE_DIR" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  log "ERROR: chezmoi source is not a Git repository."
  exit 1
fi

# Process only files already managed by chezmoi.
while IFS= read -r -d '' relative_path; do
  target="$HOME/$relative_path"

  if [[ ! -f "$target" && ! -L "$target" ]]; then
    # The tracked target was deleted.
    log "Removed target: $relative_path"
    chezmoi forget "$target"
  elif [[ -f "$target" && ! -L "$target" ]]; then
    # Update source from an existing managed regular file.
    chezmoi re-add "$target"
  fi
done < <(
  chezmoi managed \
    --include=files \
    --path-style=relative \
    --nul-path-separator
)

# Stage changes produced by the operations above.
git -C "$SOURCE_DIR" add -A

# Commit only if the source repository actually changed.
if ! git -C "$SOURCE_DIR" diff --cached --quiet; then
  timestamp="$(date '+%Y-%m-%d %H:%M:%S %Z')"

  git -C "$SOURCE_DIR" commit \
    -m "chore(dotfiles): auto-sync $timestamp"

  log "Changes committed."
else
  log "No changes to commit."
fi
