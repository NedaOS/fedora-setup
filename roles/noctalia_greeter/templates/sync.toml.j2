# noctalia-greeter sync.toml (UI + Sync; not managed by Nix)
# [session] last, [session.power] suspend/reboot/shutdown, [[session.actions]] action/command/label/glyph
# [appearance] scheme, theme_mode, corner_radius_scale, font_family
# [appearance.palette] full color role table, [appearance.wallpaper]/[appearance.wallpapers.<connector>]
# [output] layout/transforms/scales

[appearance]
corner_radius_scale = 1.0
font_family = "sans-serif"
scheme = "Synced"
theme_mode = "dark"

    [appearance.palette]
    error = "#FFB4AB"
    hover = "#B0C9E7"
    on_error = "#690005"
    on_hover = "#19324A"
    on_primary = "#003734"
    on_secondary = "#1C3533"
    on_surface = "#DDE4E2"
    on_surface_variant = "#BEC9C7"
    on_tertiary = "#19324A"
    outline = "#3F4947"
    primary = "#81D5CE"
    secondary = "#B0CCC9"
    shadow = "#000000"
    surface = "#0E1514"
    surface_variant = "#1A2120"
    tertiary = "#B0C9E7"

    [appearance.wallpaper]
    fill_mode = "crop"
    path = "{{ noctalia_greeter_state_dir }}/wallpaper.jpg"

    [appearance.wallpapers.eDP-1]
    fill_mode = "crop"
    path = "{{ noctalia_greeter_state_dir }}/wallpaper-eDP-1.jpg"

[output]
scales = "eDP-1:1.600"
transforms = "eDP-1:normal"